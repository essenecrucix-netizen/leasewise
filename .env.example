# LeaseWise environment variables
#
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | staging | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TENANT_ID=leasewise

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DISCOURSE_URL=http://localhost:4200

# ── Backend — Database ──────────────────────────────────────────────────────
# Production: Azure Database for PostgreSQL Flexible Server. SSL required.
#   POSTGRES_HOST=<workgraph-server>.postgres.database.azure.com
#   POSTGRES_SSL=true
# Local dev with apt/brew Postgres (no TLS):
#   POSTGRES_HOST=localhost
#   POSTGRES_SSL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leasewise
POSTGRES_USER=leasewise
POSTGRES_PASSWORD=leasewise_dev
POSTGRES_SSL=true

# ── Backend — Auth ──────────────────────────────────────────────────────────
# Set MOCK_AUTH=true for local development. Production startup aborts if
# this is true and ENVIRONMENT=production.
MOCK_AUTH=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
JWT_AUDIENCE=

# ── Backend — Anthropic Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# ── Backend — External APIs ─────────────────────────────────────────────────
MARKETCHECK_API_KEY=
LEASEHACKR_USER_AGENT=LeaseWise-Research/1.0 (canadian-lease-intelligence)

# ── Backend — Discourse SSO ─────────────────────────────────────────────────
DISCOURSE_URL=http://localhost:4200
DISCOURSE_SSO_SECRET=

# ── Backend — CORS ──────────────────────────────────────────────────────────
# JSON-array list of allowed frontend origins. The default works for the
# canonical `npm run dev` (port 3000). On hosts where 3000 is taken, the
# `next dev` command picks an alternative port — add it here so the
# backend doesn't reject the request. Multi-origin example for the
# Workgraph-sharing dev VM (LeaseWise dev frontend = 3010):
#     CORS_ORIGINS=["http://localhost:3000","http://localhost:3010"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Backend — Ingestion scheduler (Phase 1.4a) ──────────────────────────────
# In-process APScheduler for the LeaseHackr nightly crawl + weekly
# synthesis. DEFAULT-DISABLED. Production opts in by setting this to
# `false`. Dev sessions stay opted out automatically — the previous
# default-enabled behaviour fired crawls from any uvicorn process whose
# .env was silent on this flag and burned $1+ of Anthropic credit on
# misconfigured runs.
#
#   unset / blank   → disabled (safe default)
#   "true"  / "1"   → disabled
#   "false" / "0"   → enabled (production opts in here)
#
LEASEWISE_DISABLE_SCHEDULER=true

# ── Production only ─────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
SENTRY_DSN=
