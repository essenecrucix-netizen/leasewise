# LeaseWise environment variables
#
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | staging | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TENANT_ID=leasewise

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DISCOURSE_URL=http://localhost:4200

# ── Backend — Database ──────────────────────────────────────────────────────
# Local dev uses the host's Postgres (apt or homebrew install). On the VM,
# the same value works because uvicorn runs as a systemd unit on the same
# host as Postgres (or against an Azure private endpoint that resolves to
# localhost via the VNet). No container hostnames here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leasewise
POSTGRES_USER=leasewise
POSTGRES_PASSWORD=leasewise_dev

# ── Backend — Auth ──────────────────────────────────────────────────────────
# Set MOCK_AUTH=true for local development. Production startup aborts if
# this is true and ENVIRONMENT=production.
MOCK_AUTH=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
JWT_AUDIENCE=

# ── Backend — Anthropic Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# ── Backend — External APIs ─────────────────────────────────────────────────
MARKETCHECK_API_KEY=
LEASEHACKR_USER_AGENT=LeaseWise-Research/1.0 (canadian-lease-intelligence)

# ── Backend — Discourse SSO ─────────────────────────────────────────────────
DISCOURSE_URL=http://localhost:4200
DISCOURSE_SSO_SECRET=

# ── Backend — CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Production only ─────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
SENTRY_DSN=
