[Unit]
Description=LeaseWise Next.js frontend
After=network.target leasewise-backend.service
Wants=leasewise-backend.service

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/var/www/leasewise/frontend
EnvironmentFile=/var/www/leasewise/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/leasewise
ProtectHome=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=leasewise-frontend

[Install]
WantedBy=multi-user.target
