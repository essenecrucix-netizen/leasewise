[Unit]
Description=LeaseWise FastAPI backend (uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/var/www/leasewise/backend
EnvironmentFile=/var/www/leasewise/.env
ExecStart=/var/www/leasewise/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips="127.0.0.1"
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/leasewise
ProtectHome=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=leasewise-backend

[Install]
WantedBy=multi-user.target
